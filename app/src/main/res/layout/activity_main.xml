<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- library screen -->
        <LinearLayout
            android:id="@+id/screen_library"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="marimo"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#7dff7d" />

                <ImageButton
                    android:id="@+id/btn_settings"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@android:drawable/ic_menu_manage"
                    android:background="?android:attr/selectableItemBackground"
                    android:contentDescription="settings" />
            </LinearLayout>

            <!-- folder row: up / folder name (queue lives on the player) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="4dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/btn_up"
                    android:layout_width="56dp"
                    android:layout_height="36dp"
                    android:text="⬆"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/folder_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:maxLines="1"
                    android:ellipsize="middle"
                    android:textSize="14sp"
                    android:textColor="#c9c9d1" />
            </LinearLayout>

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/status_idle"
                android:textSize="12sp"
                android:textColor="#6b6b76" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <ListView
                    android:id="@+id/tracklist"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:divider="#2a2a30"
                    android:dividerHeight="1dp" />

                <moe.umbrella.marimo.LetterBar
                    android:id="@+id/letterbar"
                    android:layout_width="40dp"
                    android:layout_height="match_parent" />
            </LinearLayout>
        </LinearLayout>

        <!-- queue screen -->
        <LinearLayout
            android:id="@+id/screen_queue"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="queue"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#7dff7d" />

            <ListView
                android:id="@+id/q_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="12dp"
                android:divider="#2a2a30"
                android:dividerHeight="1dp" />
        </LinearLayout>

        <!-- player screen -->
        <LinearLayout
            android:id="@+id/screen_player"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/p_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="marimo"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#7dff7d" />

            <ImageView
                android:id="@+id/p_art"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="8dp"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:contentDescription="album art" />

            <TextView
                android:id="@+id/p_track"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textSize="18sp"
                android:textColor="#e8ddd0"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/p_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="14sp"
                android:textColor="#c9c9d1" />

            <TextView
                android:id="@+id/p_album"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="13sp"
                android:textColor="#6b6b76" />

            <moe.umbrella.marimo.WaveformSeekBar
                android:id="@+id/p_seek"
                android:layout_width="match_parent"
                android:layout_height="26dp"
                android:layout_marginTop="6dp" />

            <TextView
                android:id="@+id/p_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="0:00 / 0:00"
                android:textSize="12sp"
                android:textColor="#6b6b76" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/p_prev"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:src="@drawable/ic_prev"
                    android:background="?android:attr/selectableItemBackground"
                    android:contentDescription="previous" />

                <ImageButton
                    android:id="@+id/p_play"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:src="@drawable/ic_play"
                    android:background="?android:attr/selectableItemBackground"
                    android:contentDescription="play/pause" />

                <ImageButton
                    android:id="@+id/p_next"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:src="@drawable/ic_next"
                    android:background="?android:attr/selectableItemBackground"
                    android:contentDescription="next" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal"
                android:gravity="center">

                <ImageButton
                    android:id="@+id/p_shuffle"
                    android:layout_width="60dp"
                    android:layout_height="52dp"
                    android:scaleType="fitCenter"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:src="@drawable/ic_shuffle"
                    android:background="?android:attr/selectableItemBackground"
                    android:contentDescription="shuffle" />

                <ImageButton
                    android:id="@+id/p_repeat"
                    android:layout_width="60dp"
                    android:layout_height="52dp"
                    android:scaleType="fitCenter"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:src="@drawable/ic_repeat"
                    android:background="?android:attr/selectableItemBackground"
                    android:contentDescription="repeat" />
            </LinearLayout>

        </LinearLayout>
    </FrameLayout>

    <!-- bottom tab bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:background="#0d0d0f">

        <Button
            android:id="@+id/tab_player"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:text="player"
            android:textColor="#e8ddd0"
            android:textSize="13sp" />

        <Button
            android:id="@+id/tab_library"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:text="library"
            android:textColor="#e8ddd0"
            android:textSize="13sp" />

        <Button
            android:id="@+id/tab_queue"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:text="queue"
            android:textColor="#e8ddd0"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
